<Window x:Class="KorvarysHardwareDoctor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/korvarys.png" Title="KORVARYS Hardware Doctor" Width="1240" Height="760" MinWidth="980" MinHeight="620" Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0D172B" BorderBrush="#1E3154" BorderThickness="0,0,1,0"><DockPanel Margin="18,22">
      <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="KORVARYS Hardware Doctor" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="desenvolvido por 0xTPZ" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel><Image Source="/Assets/korvarys.png" Width="62" Height="62" HorizontalAlignment="Left"/><TextBlock Text="HARDWARE DOCTOR" FontSize="18" FontWeight="Bold" Margin="0,12,0,30"/><Button Content="⌂   Visão geral" Click="Overview_Click"/><Button Content="◈   Diagnóstico" Click="Diagnostics_Click"/><Button Content="◌   Desempenho" Click="Performance_Click"/><Button Content="⚙   Configurações" Click="Settings_Click"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="34,28,34,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Leitura segura do estado atual do equipamento" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock x:Name="SectionDetails" Text="Resumo do hardware detectado e disponibilidade dos sensores." FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="↻  Atualizar leitura" Click="Refresh_Click" VerticalAlignment="Center"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,18"><StackPanel>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLACA DE VÍDEO" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock x:Name="GpuName" Text="Detectando equipamento…" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,4"/><TextBlock x:Name="GpuDriver" Text="Aguardando leitura do driver" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SupportText" Text="Modo seguro: somente leitura" Foreground="#7BE0A8" Margin="0,18,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="ESTADO" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="HealthText" Text="ANALISANDO" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        <UniformGrid Columns="3" Margin="0,0,0,18"><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="TEMPERATURA" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TempText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Sensor AMD/ADL" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="5,0,5,0"><StackPanel><TextBlock Text="USO DA GPU" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UsageText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Monitoramento seguro" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="DRIVER" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DriverStatus" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Compatibilidade detectada" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></UniformGrid>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="CONTROLES DE DESEMPENHO" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Os controles serão liberados somente quando a placa e o driver confirmarem suporte via AMD ADLX." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Perfil equilibrado" Margin="0,0,8,0" Click="Profile_Click"/><Button Grid.Column="1" Content="Perfil desempenho" Margin="4,0,4,0" Click="Profile_Click"/><Button Grid.Column="2" Content="Diagnóstico seguro" Margin="8,0,0,0" Click="Diagnostics_Click"/></Grid></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <TextBlock Grid.Row="2" Text="KORVARYS Hardware Doctor  •  v0.1.0  •  0xTPZ" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
    </Grid>
  </Grid>
</Window>
